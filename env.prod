WECHAT_PLATFORM_PUBLIC_KEY_ID=PUB_KEY_ID_0111060356912026013100381600001800
# 平台公钥（推荐）：从商户平台 API安全 获取“平台公钥”，内容为 PEM。
# 支持两种方式：
# - 直接填环境变量（多行用 \n 转义）
# - 或把 PEM 文件放到 ./wechatpay/cert/platform_public_key.pem（已支持读取）
# WECHAT_PLATFORM_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
WECHAT_API_V3_KEY=p9K2mX7Qv4aT1Zr8Nw6Hs3Yc5Lj0GdEu
# 企业微信 CorpID（你说的企业ID，通常 ww 开头）
WECHAT_CORP_ID=ww574fcbef9bbba7b4
# 微信支付请求体里的 appid（大多数场景为 wx...）；如无需区分，也可只填 WECHAT_APPID 兼容旧逻辑
WECHAT_APPID=ww574fcbef9bbba7b4
# 如你实际支付侧需要 wxAppID，请改填在这里（优先级高于 WECHAT_APPID）
# WECHAT_PAY_APPID=wx***************
# 如果你明确要用 ww... 作为支付 appid（不建议），可设置为 1 跳过校验
# WECHAT_ALLOW_WW_APPID=1
WECHAT_MCHID=1106035691
# 生产环境应为 HTTPS 且不可带 query
WECHAT_NOTIFY_URL=https://guangyang.online/wechatpay/notify

# 给 docker-compose.prod.yml 用的镜像名前缀（避免默认占位符 registry.example.com）
CI_REGISTRY_IMAGE=gy
