# 生产环境示例（不要提交真实密钥）
# 用法（示例）：
#   docker compose --env-file env.prod -f docker-compose.prod.yml up -d
#
# 强烈建议：
# - 真实生产环境用 GitLab CI Variables 或服务器上的 env.prod 注入
# - 本地文件 env.prod 放到服务器磁盘并加入 .gitignore

# --- 基础 ---
PORT=8080
CORS_ALLOW_ORIGIN=*
TMP_ROOT=/app/tmp
WEB_BIND=127.0.0.1
WEB_PORT=8088
LOCAL_IMAGE_PREFIX=gy
# 默认使用项目目录下 ./runtime，GitLab CI 会设置为 $CI_PROJECT_DIR/runtime。
# 如已给 runner 用户授权，也可改成 /opt/app/gy。
GY_DATA_DIR=./runtime
# 微信支付证书和 apikey 独立放这里，目录结构为 cert/ 与 apikey/。
WECHATPAY_DIR=./wechatpay

# --- Redis（单机 Compose 内置 redis 服务；不要再指外部 Redis）---
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Compare ---
COMPARE_JOB_FEE_FEN=1
COMPARE_WORKER_CONCURRENCY=2
PAYMENT_WORKER_CONCURRENCY=4
COMPARE_MAX_UPLOAD_MB=512
COMPARE_TMP_RETENTION_MINUTES=30
XLSCONVERT_TIMEOUT_SECONDS=90

# --- OSS（单机部署默认强制关闭，上传和下载都走本机 GY_DATA_DIR/tmp）---
# docker-compose.prod.yml 会把容器内 OSS_BUCKET 置空，避免残留 CI 变量误启用 OSS。

# --- WeChatPay（可选）---
WECHAT_NOTIFY_URL=https://__REPLACE_WITH_DOMAIN__/wechatpay/notify
WECHAT_MCHID=__REPLACE_WITH_MCHID__
WECHAT_PAY_APPID=__REPLACE_WITH_WX_APPID__
WECHAT_APPID=__REPLACE_WITH_APPID_FALLBACK__
WECHAT_CORP_ID=__REPLACE_WITH_CORP_ID__
WECHAT_API_V3_KEY=__REPLACE_WITH_API_V3_KEY__
WECHAT_PLATFORM_PUBLIC_KEY_ID=__REPLACE_WITH_PUB_KEY_ID__
# WECHAT_PLATFORM_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
WECHAT_MOCK=0

# --- Observability（可选）---
LOG_LEVEL=info
APP_VERSION=dev
# OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector.otel:4317

